  },
  {
   "fieldname": "fallback_model",
   "fieldtype": "Data",
   "label": "Fallback Model"
  },
  {
   "fieldname": "section_dist",
   "fieldtype": "Section Break",
   "label": "Distribution"
  },
  {
   "fieldname": "allow_site_override",
   "fieldtype": "Check",
   "label": "Let a site override the model",
   "default": "0",
   "description": "Off means the choice here wins everywhere, which is the point of setting it here."
  },
  {
   "fieldname": "share_keys",
   "fieldtype": "Check",
   "label": "Send the API key to sites",
   "default": "0",
   "description": "Off means each site keeps its own key and only the provider and model come from here. Turn on only for sites you operate."
  },
