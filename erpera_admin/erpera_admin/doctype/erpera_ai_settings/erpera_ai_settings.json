   "fieldtype": "Section Break",
   "label": "What sites should record"
  },
  {
   "fieldname": "log_calls",
   "fieldtype": "Check",
   "label": "Record every call",
   "default": "1"
  },
  {
   "fieldname": "log_content",
   "fieldtype": "Check",
   "label": "Record prompts and responses",
   "default": "0",
   "description": "Prompts and responses are the client's own business data. Off by default."
  },
  {
   "fieldname": "content_retention_days",
   "fieldtype": "Int",
   "label": "Delete content after (days)",
   "default": "30"
  },
  {
   "fieldname": "section_ingest",
   "fieldtype": "Section Break",
   "label": "Here"
  },
  {
   "fieldname": "ingest_enabled",
   "fieldtype": "Check",
   "label": "Accept call batches",
   "default": "1"
  },
  {
   "fieldname": "keep_records_days",
   "fieldtype": "Int",
   "label": "Keep call records for (days)",
   "default": "0",
   "description": "0 keeps them forever. Tokens and cost are what billing runs on."
  },
  {
   "fieldname": "section_selfserve",
   "fieldtype": "Section Break",
   "label": "Self-serve sign-up"
