   "label": "Let customers sign up themselves",
   "default": "1",
   "description": "Turns the /account portal on. With this off, keys can only be issued here by hand."
  },
  {
   "fieldname": "trial_days",
   "fieldtype": "Int",
   "label": "Trial length (days)",
   "default": "15"
